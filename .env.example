# ---------------------------------------------------------------------------
# TechTitans-28 CR Election Portal — environment variables
# Copy to .env.local for development. NEVER commit real values.
# ---------------------------------------------------------------------------

# development | test | staging | production   (staging/production enable strict checks)
APP_ENV=development
# Public origin of the site (used for CSRF origin checks). HTTPS required in production.
APP_URL=http://localhost:3000

# Application database connection — MUST use a login role that is a member of
# `techtitans_app` (NOT postgres / service_role). See DEVELOPMENT.md.
DATABASE_URL=postgres://techtitans_app_user:dev_app_password@localhost:5432/techtitans
# disable | require | verify   (verify + DATABASE_CA_CERT recommended for Supabase)
DATABASE_SSL=disable
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
DATABASE_POOL_MAX=10

# Owner connection used ONLY by scripts (migrations, seed, admin bootstrap). Not needed at runtime.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/techtitans

# 32+ random characters: HMAC key for OTPs, session tokens, rate-limit keys, IP pseudonyms.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET_PEPPER=change-me-to-48-random-bytes-change-me-to-48-random
# 32 random bytes, base64: encrypts admin MFA secrets at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# OTP delivery: dev (in-memory outbox at /api/dev/outbox, development only) | live
OTP_PROVIDER=dev
# Email OTP (students whose registered contact is an email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TechTitans-28 Election Committee <no-reply@example.edu>"
# SMS OTP (students whose registered contact is a phone): generic HTTPS gateway
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=

# Candidate photos / correction evidence: database (dev) | supabase
STORAGE_DRIVER=database
SUPABASE_URL=
# Server-side only. Never expose to the browser (no NEXT_PUBLIC_ prefix!).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=candidate-photos
SUPABASE_EVIDENCE_BUCKET=correction-evidence

# true on Vercel / behind a trusted reverse proxy (use x-forwarded-for for rate limiting)
TRUST_PROXY_HEADERS=false
